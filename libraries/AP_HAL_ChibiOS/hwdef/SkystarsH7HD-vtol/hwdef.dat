# hw definition file for processing by chibios_pins.py
# for SkystarsH7HD

include ../SkystarsH7HD/hwdef.dat

SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 EMPTY UART7 UART8

undef PB0 PB1 PD12 PA0 PA1 PA2 PA3 PA8 PC6 PC7 PD0 PD1 PD8 PD9 PD13 PB5 PB6 PE0 PE1
undef DMA_PRIORITY DMA_NOSHARE HAL_I2C_INTERNAL_MASK
undef DEFAULT_SERIAL6_PROTOCOL DEFAULT_SERIAL6_BAUD

MCU_CLOCKRATE_MHZ 480

DMA_PRIORITY TIM3* TIM1* TIM4* TIM2* SPI1* SPI3* SPI4*
DMA_NOSHARE TIM3* TIM4* TIM2* SPI1* SPI3*

define HAL_I2C_INTERNAL_MASK 1

define RELAY2_PIN_DEFAULT 81 # Pit-1
define RELAY3_PIN_DEFAULT 82 # PIN-EN

# Motor order Betaflight/X
define HAL_FRAME_TYPE_DEFAULT 12

# USART1 (RX)
define DEFAULT_SERIAL1_PROTOCOL 23
define DEFAULT_SERIAL1_BAUD 460
# USART3 (ESC Telem)
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3 NODMA
# UART4 (GPS)
PD0 UART4_RX UART4 NODMA
PD1 UART4_TX UART4 NODMA
# UART5 (VTX)
PB5 UART5_RX UART5 NODMA
PB6 UART5_TX UART5 NODMA
# USART6 is reassigned to PWM10
# UART7
# UART8
PE0 UART8_RX UART8 NODMA
PE1 UART8_TX UART8 NODMA

# ---------------------------------------------------------
# PWM Output Definitions for Custom VTOL Build
# ---------------------------------------------------------

# --- GROUP A: FRONT MOTORS (DShot/BDShot) --
PB0  TIM3_CH3 TIM3 PWM(1) GPIO(50) BIDIR
PB1  TIM3_CH4 TIM3 PWM(2) GPIO(51) BIDIR

# --- GROUP B: TILT SERVOS (Standard PWM) ---
PD12 TIM4_CH1 TIM4 PWM(3) GPIO(52)
PD13 TIM4_CH2 TIM4 PWM(4) GPIO(53)

# --- GROUP C: CONTROL SURFACES (Standard PWM) ---
PA0  TIM2_CH1 TIM2 PWM(5) GPIO(54)
PA1  TIM2_CH2 TIM2 PWM(6) GPIO(55)
PA2  TIM2_CH3 TIM2 PWM(7) GPIO(56)
PA3  TIM2_CH4 TIM2 PWM(8) GPIO(57)

# --- GROUP D: REAR MOTOR (DShot/BDShot) ---
PA8  TIM1_CH1 TIM1 PWM(9) GPIO(58) BIDIR

# --- GROUP E: NEOPIXEL LED ---
# Hijacking UART6_TX (PC6) for NeoPixel use.
# Mapped to TIM8 to ensure no conflict with Motors (TIM1/3) or Servos (TIM2/4).
PC6  TIM8_CH1 TIM8 PWM(10) GPIO(60)
